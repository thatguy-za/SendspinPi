[Unit]
Description=SendspinPi web UI
After=network.target NetworkManager.service
Wants=NetworkManager.service

[Service]
WorkingDirectory=/opt/sendspinpi/app
ExecStart=/usr/bin/python3 -m sendspinpi
Restart=always
RestartSec=3
# Runs as root: needs port 80, nmcli, apt and systemctl.

[Install]
WantedBy=multi-user.target
